# ---------------------------------------------------------------
# Grand Travela — Environment Variables (placeholders only)
# Never commit real credentials. Real values go in .env (gitignored)
# and in Vercel Project Settings → Environment Variables.
# ---------------------------------------------------------------

# REQUIRED — Neon PostgreSQL "pooled" connection string
# (Neon dashboard → Connection string → 'Pooled' tab)
# Format: postgres://role:password@ep-xxx-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=

# OPTIONAL — Neon "direct" (non-pooled) connection string.
# Used by scripts/migrate-to-neon.ts when running schema migrations against
# a branch that requires a direct connection. Falls back to DATABASE_URL.
DIRECT_URL=

# REQUIRED for hotel image uploads/delivery - Vercel Blob PRIVATE store token.
# Create a private Blob store in the Vercel dashboard, connect it to this
# project, then either run `vercel env pull` locally or paste the value here.
# In production Vercel injects this automatically when the store is connected.
# SERVER-ONLY: never expose via a client/NEXT_PUBLIC variable, API response or log.
# When the store is connected via OIDC this may be absent on Vercel; SDK uses
# VERCEL_OIDC_TOKEN + BLOB_STORE_ID automatically in that case.
BLOB_READ_WRITE_TOKEN=

# Optional
PORT=3000
